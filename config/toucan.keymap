#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "keymap_belgian.h"

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        gresc2: quote_doublequote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BE_QUOT>, <&kp BE_DQUO>;
            mods = <(MOD_LSFT)>;
        };
    };
      
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp BE_A &kp BE_Z &kp BE_E &kp BE_R &kp BE_T   &kp BE_Y &kp BE_U  &kp BE_I     &kp BE_O   &kp BE_P    &kp BSPC
                &kp LCTRL &kp BE_Q &kp BE_S &kp BE_D &kp BE_F &kp BE_G   &kp BE_H &kp BE_J  &kp BE_K     &kp BE_L   &kp BE_M &kp SQT
                &kp LSHFT &kp BE_W &kp BE_X &kp BE_C &kp BE_V &kp BE_B   &kp BE_N &kp BE_COMM  &kp BE_SCLN &kp BE_COLN &gresc2 &kp ESC
                                &kp LGUI &mo NAV &mt LSHIFT ESC             &kp SPACE &mo SYM &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
              &bt BT_CLR &kp ESC  &kp LA(TAB) &kp LC(TAB)  &trans  &trans                &kp HOME &kp PG_DN &kp PG_UP &kp END &caps_word &bt BT_SEL 0
              &bt BT_PRV &sk LGUI &sk LALT &sk LCTRL &sk LSHIFT &kp RALT                 &kp LEFT &kp DOWN  &kp UP  &kp RIGHT &kp DEL &bt BT_SEL 1
              &bt BT_NXT &kp LC(BE_Z)  &kp LC(BE_X) &kp LC(BE_C) &kp TAB &kp LC(BE_V)    &kp LC(BSPC) &kp BSPC &trans &trans &trans &bt BT_SEL 2
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp BE_1 &kp BE_2 &kp BE_3 &kp BE_4 &kp BE_5                   &kp BE_6  &kp BE_7  &kp BE_8 &kp BE_9 &kp BE_0 &kp BSPC
                &kp LCTRL &kp BE_LESS &kp BE_PERC &kp BE_LPRN &kp BE_LBRC &kp BE_LCBR    &kp BE_HASH &kp BE_EQL &kp BE_BSLS &kp BE_PLUS &kp BE_ASTR &kp BSPC
                &kp LSHFT &kp BE_GREAT &kp BE_DLR &kp BE_RPRN &kp BE_RBRC &kp BE_RCBR    &kp BE_AT &kp BE_EXLM &kp BE_UNDS &kp BE_MINS &kp BE_PIPE &kp BSPC
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &mo TAB &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &none &none
                &kp LCTRL &sk LGUI &sk LALT &sk LCTRL &sk LSHIFT &kp RALT   &none &kp F10 &kp F11 &kp F12 &none &none
                &bt LSHFT &trans &none &none &none &none                    &trans &trans &trans &trans &trans &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};